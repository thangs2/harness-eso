{
  "name": "@local/agentmemory-mcp-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One AgentMemory MCP plugin for many repos: resolves the memory server and its credential per workspace, then mounts the server's tools per session.",
  "exports": {
    ".": "./src/plugin.mjs",
    "./tenant": "./src/tenant.mjs",
    "./client": "./src/mcp-stdio-client.mjs",
    "./livez": "./src/livez.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "selfcheck": "node src/selfcheck.mjs"
  },
  "files": [
    "src/plugin.mjs",
    "src/mcp-stdio-client.mjs",
    "src/tenant.mjs",
    "src/livez.mjs",
    "src/selfcheck.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
