{
  "name": "@mu/eso-ui",
  "version": "0.1.0",
  "private": true,
  "description": "ESO Control Plane UI - Angular 22 (Fuse) Monorepo",
  "type": "module",
  "main": "src/index.mjs",
  "scripts": {
    "build": "tsc",
    "build:ng": "ng build",
    "check:structure": "node scripts/check-structure.mjs",
    "gate": "npm run typecheck && npm run check:structure && npm test && npm run build:ng",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "serve": "ng serve --port 4200 --host 127.0.0.1",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "rxjs": "^7.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "typescript": "6.0.3"
  }
}
